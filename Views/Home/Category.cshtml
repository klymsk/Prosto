@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Styles {
    <link rel="stylesheet" href="~/css/stylesCategory.css" asp-append-version="true" />
}
<main>
    <h2>Смартфони</h2>
    <section class="subMain">
        <aside>
            <h3>Фільтр</h3>
            <section class= "filterLine">
                @for (int i = 0; i < 4; i++)
                {
                    <section class="filterOption">
                        <p>Виробник</p>

                        <div class="checkbox-item">
                            <input type="checkbox" id="apple" name="manufacturer" value="Apple">
                            <label for="apple">Apple</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="samsung" name="manufacturer" value="Samsung">
                            <label for="samsung">Samsung</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="xiaomi" name="manufacturer" value="Xiaomi">
                            <label for="xiaomi">Xiaomi</label>
                        </div>
                        <div class="checkbox-item">
                            <input type="checkbox" id="google" name="manufacturer" value="Google">
                            <label for="google">Google</label>
                        </div>
                    </section>

                }
            </section>
        </aside>
        <section class="catalog">
            @for (int i = 0; i < 3; i++)
            {
                <section class="catalogLine">
                    @for (int j = 0; j < 4; j++)
                    {
                        <a href="@Url.Action("Index", "Item")" class="item">
                            <section class="item">
                                <img src="/assets/item/iphone.png" alt="itemImg">

                                <p>Iphone 17 Pro 256GB Deep Blue</p>

                                <div class="buyBox">
                                    <p>63 999 ₴</p>
                                    <button>Купити</button>
                                </div>
                            </section>
                        </a>
                    }
                </section>
            }
        </section>
    </section>
</main>