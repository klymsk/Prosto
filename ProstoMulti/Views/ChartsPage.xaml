<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:microcharts="clr-namespace:Microcharts.Maui;assembly=Microcharts.Maui"
             xmlns:vm="clr-namespace:ProstoMulti.ViewModels"
             x:Class="ProstoMulti.Views.ChartsPage"
             Title="ChartsPage">

    <ContentPage.BindingContext>
        <vm:ChartsViewModel />
    </ContentPage.BindingContext>
    <VerticalStackLayout>
        <Label Text="Number of items in each category" Margin="0,20" HorizontalTextAlignment="Center"/>
        <microcharts:ChartView Chart="{Binding Chart}" HeightRequest="440" WidthRequest="700"/>
    </VerticalStackLayout>
</ContentPage>