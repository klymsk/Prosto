<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProstoMulti.ViewModels"
             x:Class="ProstoMulti.Views.CustomersPage">

    <ContentPage.BindingContext>
        <vm:CustomersViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <StackLayout Padding="15">
            <Label Text="You can add new customer:" TextColor="#6955D4" Margin="0, 20"/>
            
            <Label Text="Phone number:"/>
            <Entry Placeholder="Phone Number" Text="{Binding PhoneNumber}" Margin="0,20"/>
            <Label Text="Password:"/>
            <Entry Placeholder="Password" Text="{Binding Password}" Margin="0,20"/>
            <Label Text="Full name:"/>
            <Entry Placeholder="Full Name" Text="{Binding FullName}" Margin="0,20"/>
            <Label Text="Email:"/>
            <Entry Placeholder="Email" Text="{Binding Email}" Margin="0,20"/>

            <Button Text="Add" Command="{Binding AddCustomerCommand}" BackgroundColor="#FFFFE3" Margin="0,40"/>
            <Label Text="List of customers:" Margin="0, 20"/>

            <ActivityIndicator 
            IsRunning="{Binding IsBusy}" 
            IsVisible="{Binding IsBusy}" />

            <CollectionView ItemsSource="{Binding Customers}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame Margin="5" Padding="10" BorderColor="LightGray">
                            <VerticalStackLayout>
                                <Label Text="{Binding FullName}" FontAttributes="Bold" />
                                <Label Text="{Binding Email}" />
                                <Label Text="{Binding PhoneNumber}" />
                                <Button Text="Remove" BackgroundColor="#6D8196" TextColor="White"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:CustomersViewModel}}, Path=DeleteCustomerCommand}"
                                    CommandParameter="{Binding .}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </StackLayout>
    </ScrollView>
</ContentPage>