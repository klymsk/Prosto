<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ProstoMulti.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ProstoMulti"
    xmlns:views="clr-namespace:ProstoMulti.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="ProstoMulti">

    <TabBar>

        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />

        <ShellContent 
            Title="Login"
            ContentTemplate="{DataTemplate views:Login}"
            />

    </TabBar>

    <FlyoutItem Title="About us">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" Route="MainPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Login">
        <ShellContent ContentTemplate="{DataTemplate views:Login}"/>
    </FlyoutItem>

    <FlyoutItem Title="Items">
        <ShellContent ContentTemplate="{DataTemplate views:ItemsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Customers">
        <ShellContent ContentTemplate="{DataTemplate views:CustomersPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cart Items">
        <ShellContent ContentTemplate="{DataTemplate views:CartItemsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Chart">
        <ShellContent ContentTemplate="{DataTemplate views:ChartsPage}" />
    </FlyoutItem>
</Shell>